# 배포 설정 — `cp .env.example .env` 후 필요한 값만 채운다. deploy.sh 가 읽는다.

# T-Pot 웹UI 계정 (install.sh -u / -p 로 전달)
WEB_USER=tpotadmin
# 비워두면 deploy.sh 가 무작위 20자 생성해 ./webpw.txt 에 저장한다.
WEB_PASS=

# Ollama 기본 모델 (CPU 환경: 느리면 llama3.2:3b 등 경량으로 교체)
OLLAMA_MODEL=llama3.1:8b

# LLM 제공자 — 기본 ollama. openai/anthropic/gemini/openai-compatible 사용 시에만 키 채움.
LLM_PROVIDER=ollama
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
